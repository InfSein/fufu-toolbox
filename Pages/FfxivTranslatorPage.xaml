<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="fufu_toolbox.Pages.FfxivTranslatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="30" FontWeight="SemiBold" Text="FFXIV 翻译器" />

        <StackPanel Grid.Row="1" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="PermanentTermsButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                        <TextBlock Text="常驻术语表" />
                    </StackPanel>
                </Button>
                <Button Click="CustomTermsButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                        <TextBlock Text="自定术语表" />
                    </StackPanel>
                </Button>
                <Button Click="ExtraRequirementsButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                        <TextBlock Text="额外要求" />
                    </StackPanel>
                </Button>
                <Button Click="LlmSettingsButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                        <TextBlock Text="大模型设置" />
                    </StackPanel>
                </Button>
                <Button Click="PromptSettingsButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8D5;" FontSize="14" />
                        <TextBlock Text="提示词设置" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="12"
                CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="输入（日语）" />

                    <TextBox
                        x:Name="InputTextBox"
                        Grid.Row="1"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        TextChanged="InputTextBox_TextChanged"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="12"
                CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="输出（中文）" />

                    <TextBox
                        x:Name="OutputTextBox"
                        Grid.Row="1"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Click="LogButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" />
                    <TextBlock Text="日志" />
                </StackPanel>
            </Button>

            <InfoBar
                x:Name="ToastInfoBar"
                Grid.Column="1"
                IsOpen="False"
                IsClosable="False"
                IsIconVisible="True" />

            <Button
                x:Name="TranslateButton"
                Grid.Column="3"
                HorizontalAlignment="Right"
                Content="执行"
                Click="TranslateButton_Click" />
        </Grid>
    </Grid>
</Page>
